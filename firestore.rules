rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 기본 읽기/쓰기 허용 (해커톤 클라이언트 앱용)
    match /{document=**} {
      allow read, write: if true;
    }

    // generations 컬렉션 읽기/쓰기 허용
    match /generations/{genId} {
      allow read, write: if true;
    }

    // projects 및 하위 컬렉션 읽기/쓰기 허용
    match /projects/{projectId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
      match /deployments/{logId} {
        allow read, write: if true;
      }
    }

    // settings 컬렉션 읽기/쓰기 허용
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // students, matchups, project_secrets 컬렉션
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /matchups/{matchupId} {
      allow read, write: if true;
    }
    match /project_secrets/{secretId} {
      allow read, write: if true;
    }
    match /comment_secrets/{secretId} {
      allow read, write: if true;
    }
  }
}
